APP_ENV=development
DATABASE_URL=mysql+asyncmy://scm_dev:CHANGE_ME@127.0.0.1:3306/zhongcheng_scm_dev
AUTH_JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_DEVELOPMENT_SECRET
AUTH_ACCESS_TOKEN_MINUTES=30
AUTH_REFRESH_IDLE_DAYS=3
AUTH_SESSION_ABSOLUTE_DAYS=30
AUTH_REFRESH_ROTATION_GRACE_SECONDS=30
# Production HTTPS deployments must set this to true.
AUTH_REFRESH_COOKIE_SECURE=false
# For MySQL 8 accounts using caching_sha2_password, cryptography is included
# in the backend dependencies. Do not commit real local credentials in .env.
CORS_ORIGINS=http://localhost:5173
TASK_MODE=inline
STORAGE_MODE=local
# 相对路径会基于项目根目录解析；实际媒体文件受根目录 .gitignore 隔离。
LOCAL_STORAGE_PATH=local-data/files
# 商品大表使用分块上传和磁盘只读解析；默认支持 1GB / 100,000 个数据行，可按部署资源调整。
PRODUCT_IMPORT_MAX_FILE_MB=1024
PRODUCT_IMPORT_MAX_ROWS=100000
PRODUCT_IMPORT_MAX_CONCURRENT_WORKBOOKS=1
# 单张内嵌图片上限；图片逐张流式处理，不限制整本工作簿的图片总量。
PRODUCT_IMPORT_MAX_IMAGE_MB=64
# 仅用于首次部署。创建成功后可删除这两项；同名账号（含已删除）不会被自动恢复或重建。
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_PASSWORD=
REDIS_ENABLED=false
MINIO_ENABLED=false
# 类型4自由推品 Agent。密钥留空时应用仍可启动，但运行 Agent 会明确提示未配置。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_SECONDS=60
DEEPSEEK_MAX_TOKENS=4096
DEEPSEEK_PROMPT_VERSION=free-recommendation-v1
